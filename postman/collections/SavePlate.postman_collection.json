              "raw": "{{baseUrl}}/meal-plan?weekStart=2026-05-25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "meal-plan"
              ],
              "query": [
                {
                  "key": "weekStart",
                  "value": "2026-05-25"
