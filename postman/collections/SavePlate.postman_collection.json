              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Banana Bread\",\n  \"qty\": \"1 loaf\",\n  \"category\": \"Bakery\",\n  \"expiryDate\": \"2026-06-10\",\n  \"storageType\": \"Pantry\",\n  \"pickupLocation\": \"lobby of Stikom Bali\",\n  \"availability\": \"Mon-Fri 10AM-4PM\",\n  \"notes\": \"Vegan banana bread\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/donations",
