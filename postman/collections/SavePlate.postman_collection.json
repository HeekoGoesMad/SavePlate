    {
      "name": "Use Case 6: Plan Weekly Meals",
      "item": [
        {
          "name": "1. Save Meal Plan Calendar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weekStart\": \"2026-05-25\",\n  \"slots\": [\n    {\n      \"dayIso\": \"2026-05-25\",\n      \"slot\": \"Breakfast\",\n      \"meals\": [\n        {\n          \"name\": \"Cereal with Milk\",\n          \"ingredient\": \"Fresh Milk\"\n        }\n      ]\n    }\n  ],\n  \"isConfirmed\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/meal-plan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "meal-plan"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Meal plan saved successfully\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"mealPlanId\", jsonData._id);",
                  "    pm.expect(jsonData._id).to.not.be.undefined;",
                  "    pm.expect(jsonData.weekStart).to.equal(\"2026-05-25\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
